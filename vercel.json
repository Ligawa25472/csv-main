{
  "version": 2,
  "framework": "angular",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": "dist/cv-mo/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.csr.html"
    }
  ]
}
